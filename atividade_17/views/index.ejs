<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mensagem do Dia - Ron Swanson</title>
    <link href="https://jsdelivr.net" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .quote-card {
            background: white;
            border-left: 5px solid #0d6efd;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body class="d-flex align-items-center min-vh-100">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <h1 class="mb-4 text-primary fw-bold">📜 Mensagem do Dia</h1>
                <div class="quote-card p-5 my-4">
                    <p class="fs-4 fst-italic font-monospace text-dark">
                        "<%= frase %>"
                    </p>
                    <span class="text-muted d-block mt-3 text-end">— Ron Swanson</span>
                </div>
                <a href="/" class="btn btn-primary btn-lg shadow-sm mt-2">🔄 Nova Mensagem</a>
            </div>
        </div>
    </div>
</body>
</html>
